*.egg
MANIFEST
rust/target/

# Build-context stability. CI clones this fork fresh for every run, so the
# root .git tree (FETCH_HEAD, reflogs, pack checksums) differs byte-for-byte
# even when the commit is identical. With it in the context the
# `COPY . /src/vllm` layer digest changed every build and invalidated the
# ~3h of CUDA compile layers underneath it. The commit and the
# setuptools-scm version are passed as build args instead
# (VLLM_SOURCE_COMMIT / VLLM_SCM_VERSION).
.git
.github

# Never read by the wheel build (packages are vllm* only), but large enough
# to slow the context upload and to invalidate layers on doc-only commits.
docs
examples
benchmarks

.logs
